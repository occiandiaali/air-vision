<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>AERO // Particulate & Mist Visualizer</title>
  <link rel="stylesheet" href="/css/style.css" />
  <script src="https://unpkg.com/htmx.org@2.0.3"></script>
</head>
<body>
  <!-- Launch Screen -->
  <main id="launchScreen" class="launch-screen">
    <div class="launch-card">
      <div class="launch-tag">AERO-CV // PHASE 1.1</div>
      <h1>Airborne Particulate &amp; Flow Visualizer</h1>
      <p class="launch-copy">
        Real-time mobile camera processing using OpenCV.js to isolate floating particulates in orange,
        render mist dispersion trails, and map air movement vectors.
      </p>
      <ul class="launch-specs">
        <li><strong>Orange Top-Hat Isolate:</strong> Suppresses broad room backgrounds</li>
        <li><strong>Flow Vector Arrows:</strong> Tracks frame-to-frame drift direction</li>
        <li><strong>Cluster Map:</strong> Highlights spatial density zones</li>
      </ul>
      <div id="engineStatus" class="engine-status">Loading OpenCV.js WASM engine...</div>
      <button id="launchBtn" class="btn-primary" disabled>Launch Sensor</button>
    </div>
  </main>

  <!-- Live AR Viewing Screen -->
  <div id="arViewport" class="ar-viewport hidden">
    <video id="videoInput" playsinline autoplay muted></video>
    <canvas id="canvasOutput"></canvas>

    <header class="hud-top">
      <div class="brand">
        <span class="pulse-dot" id="statusDot"></span>
        <span>AERO-CV</span>
      </div>
      <div class="metrics">
        <span id="fpsCounter">0 FPS</span>
        <span id="particleIndex">DENSITY: --</span>
      </div>
    </header>

    <section id="modeInfoContainer" class="hud-info-card">
      <%- include('partials/mode-info', { mode: initialMode }) %>
    </section>

    <footer class="hud-controls">
      <div class="mode-selector">
        <button
          class="mode-btn active"
          data-mode="raw_particulate"
          hx-get="/hud/mode/raw_particulate"
          hx-target="#modeInfoContainer"
          hx-swap="innerHTML">
          Orange Isolate
        </button>
        <button
          class="mode-btn"
          data-mode="mist"
          hx-get="/hud/mode/mist"
          hx-target="#modeInfoContainer"
          hx-swap="innerHTML">
          Mist Trail
        </button>
        <button
          class="mode-btn"
          data-mode="density_heatmap"
          hx-get="/hud/mode/density_heatmap"
          hx-target="#modeInfoContainer"
          hx-swap="innerHTML">
          Cluster Map
        </button>
      </div>

      <div class="action-row">
        <button id="flowToggleBtn" class="toggle-btn active" type="button">Flow Arrows: ON</button>
        <button id="homeBtn" class="toggle-btn" type="button">Launch Screen</button>
        <button id="flipCamBtn" class="icon-btn" type="button" title="Flip Camera">⟳</button>
      </div>

      <div class="sliders">
        <label>
          <span>Sensitivity</span>
          <input type="range" id="sensitivitySlider" min="5" max="65" value="28" />
        </label>
        <label>
          <span>Mist Persistence</span>
          <input type="range" id="mistPersistenceSlider" min="40" max="95" value="82" />
        </label>
      </div>
    </footer>
  </div>

  <script src="/js/vision.js"></script>
  <script async src="https://cdn.jsdelivr.net/npm/@techstark/opencv-js@4.10.0-release.1/dist/opencv.min.js" onload="onOpenCvReady();"></script>
</body>
</html>